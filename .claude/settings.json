{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(uv run *)",
      "Bash(curl -s http://localhost:3000/*)",
      "mcp__claude_ai_HubSpot__get_*",
      "mcp__claude_ai_HubSpot__search_*",
      "mcp__claude_ai_HubSpot__query_crm_data",
      "mcp__claude_ai_HubSpot__discover_hubspot_schema"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(git switch -c*)",
      "Bash(git checkout -b*)",
      "Bash(git worktree*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf *)",

      "mcp__claude_ai_Gmail__*",
